{
  "name": "pitcrew",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --experimental-sqlite node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@types/node": "22.18.10",
    "eslint": "9.37.0",
    "openpitstop": "1.10.0",
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "3.2.4"
  }
}
