{
  "name": "@pitcrew/desktop",
  "version": "0.1.0",
  "description": "PitCrew desktop application: local-first AI software engineering orchestration with independent verification.",
  "author": "PitCrew contributors",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build": "node build.mjs",
    "preflight:electron": "node ../../scripts/repair-electron.mjs",
    "desktop": "pnpm run --if-present preflight:electron && node build.mjs && electron .",
    "dist": "pnpm run --if-present preflight:electron && node build.mjs && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.pitcrew.desktop",
    "productName": "PitCrew",
    "asar": true,
    "files": [
      "electron/**",
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "../../release/desktop-resources",
        "to": "pitcrew"
      }
    ],
    "directories": {
      "output": "../../release/desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PitCrew-Setup-${version}.exe"
    }
  }
}
